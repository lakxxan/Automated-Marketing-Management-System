pipeline {
  agent {
    docker {
      image 'node:20'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock -v /usr/bin/docker:/usr/bin/docker'
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        sh 'cd backend && npm install && npm test --if-present'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://3.107.160.128:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd backend && npx sonarqube-scanner -Dsonar.projectKey=mern-backend -Dsonar.sources=. -Dsonar.exclusions=**/node_modules/** -Dsonar.token=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "lakxxan/mern-backend:${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
          sh 'cd backend && docker build -t ${DOCKER_IMAGE} .'
          def dockerImage = docker.image("${DOCKER_IMAGE}")
          docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
            dockerImage.push()
          }
        }
      }
    }
    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "Automated-Marketing-Management-System"
        GIT_USER_NAME = "lakxxan"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "lakshan.lr2016@gmail.com"
            git config user.name "Lakshan Rathnayake"
            BUILD_NUMBER=${BUILD_NUMBER}
            sed -i "s|mern-backend:.*|mern-backend:${BUILD_NUMBER}|g" k8s/deployment.yml
            git add k8s/deployment.yml
            git commit -m "Update backend deployment image to version ${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
          '''
        }
      }
    }
  }
}