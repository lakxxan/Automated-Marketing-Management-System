pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        sh 'cd backend && npm install && npm test --if-present'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://3.107.160.128:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd backend && npx sonarqube-scanner -Dsonar.projectKey=mern-backend -Dsonar.sources=. -Dsonar.exclusions=**/node_modules/** -Dsonar.token=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "lakxxan/mern-backend:${BUILD_NUMBER}"
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            cd backend
            docker build -t ${DOCKER_IMAGE} .
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push ${DOCKER_IMAGE}
          '''
        }
      }
    }
    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "Automated-Marketing-Management-System"
        GIT_USER_NAME = "lakxxan"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "lakxxan@users.noreply.github.com"
            git config user.name "lakxxan"
            git pull https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git implement --rebase
            sed -i "s|mern-backend:.*|mern-backend:${BUILD_NUMBER}|g" k8s/deployment.yml
            git add k8s/deployment.yml
            git commit -m "Update backend deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:implement
          '''
        }
      }
    }
  }
}
