pipeline {
  agent {
    docker {
      image 'node:20'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock -v /usr/bin/docker:/usr/bin/docker'
    }
  }

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        sh 'cd frontend && npm install && npm run build'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://3.107.160.128:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd frontend && npx sonarqube-scanner -Dsonar.projectKey=mern-frontend -Dsonar.sources=src -Dsonar.exclusions=**/node_modules/**,**/build/**,**/dist/** -Dsonar.token=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "lakxxan/mern-frontend:${BUILD_NUMBER}"
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            cd frontend
            docker build -t ${DOCKER_IMAGE} .
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push ${DOCKER_IMAGE}
          '''
        }
      }
    }
    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "Automated-Marketing-Management-System"
        GIT_USER_NAME = "lakxxan"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config --global --add safe.directory '*'
            git config --global user.email "lakxxan@users.noreply.github.com"
            git config --global user.name "lakxxan"

            rm -rf /tmp/repo-update
            git clone -b implement https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git /tmp/repo-update
            cd /tmp/repo-update

            sed -i "s|mern-frontend:.*|mern-frontend:${BUILD_NUMBER}|g" k8s/deployment.yml
            git add k8s/deployment.yml
            git commit -m "Update frontend deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:implement
          '''
        }
      }
    }
  }
}